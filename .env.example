# MONGODB_URI: MongoDB Atlas connection string (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/memed?retryWrites=true&w=majority)
# If omitted, the server operates seamlessly in resilient embedded store mode.
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/memed?retryWrites=true&w=majority"

# JWT_SECRET: Secret key for signing and verifying JWT authentication tokens
JWT_SECRET="memed-marketplace-jwt-secret-key-2026"

# PORT: Server listening port (default: 3000)
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
